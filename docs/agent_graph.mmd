---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	router(router)
	retriever(retriever)
	grader(grader)
	rewriter(rewriter)
	generator(generator)
	verifier(verifier)
	refuser(refuser)
	__end__([<p>__end__</p>]):::last
	__start__ --> router;
	generator --> verifier;
	grader -. &nbsp;generate&nbsp; .-> generator;
	grader -. &nbsp;refuse&nbsp; .-> refuser;
	grader -. &nbsp;rewrite&nbsp; .-> rewriter;
	retriever --> grader;
	rewriter --> retriever;
	router --> retriever;
	refuser --> __end__;
	verifier --> __end__;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc

